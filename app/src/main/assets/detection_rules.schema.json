{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WACR detection rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "packages", "connection", "endDebounceMs", "reconnectWindowMs", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$" },
    "packages": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": { "enum": ["com.whatsapp", "com.whatsapp.w4b"] }
    },
    "connection": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "template", "ongoingCallType", "requireOngoing", "requireChronometer", "requireCommunicationMode"],
      "properties": {
        "category": { "const": "call" },
        "template": { "const": "CallStyle" },
        "ongoingCallType": { "const": 2 },
        "requireOngoing": { "const": true },
        "requireChronometer": { "const": true },
        "requireCommunicationMode": { "const": true }
      }
    },
    "endDebounceMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
    "reconnectWindowMs": { "const": 30000 },
    "profiles": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["packageName", "versionName", "callWindowClasses", "callerField", "evidence"],
        "properties": {
          "packageName": { "enum": ["com.whatsapp", "com.whatsapp.w4b"] },
          "versionName": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,4}$", "maxLength": 80 },
          "callWindowClasses": {
            "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^com\\.whatsapp\\.[a-zA-Z0-9_.$]+$", "maxLength": 200 }
          },
          "callerField": { "const": "notification_title" },
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["deviceModel", "sdkInt", "capturedOn", "verifiedScenarios", "limitations"],
            "properties": {
              "deviceModel": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$" },
              "sdkInt": { "type": "integer", "minimum": 33, "maximum": 100 },
              "capturedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" },
              "verifiedScenarios": {
                "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
                "items": { "enum": ["outgoing_voice", "incoming_voice", "outgoing_video", "incoming_video", "group", "missed", "declined", "hold_reconnect"] }
              },
              "limitations": {
                "type": "array", "maxItems": 16, "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z0-9_]{1,80}$" }
              }
            }
          }
        }
      }
    }
  }
}
